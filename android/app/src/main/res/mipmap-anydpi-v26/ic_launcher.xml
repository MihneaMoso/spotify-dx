<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): the artwork foreground fills the
     launcher mask itself (circle/squircle), so no white fill and no
     shrink-into-a-square. Legacy PNGs remain as the pre-26 fallback. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
