<?xml version="1.0" encoding="utf-8"?>
<!-- Echo-port dimension tokens (Phase 1). House radii + component metrics
     distilled from Echo's Theme.kt / Dimensions.kt (24/28dp rule, pill
     shapes, artwork radii). Layout files adopt these in later phases. -->
<resources>
    <!-- House corner radii (Echo: 24dp/28dp/Circle, elevation 0). -->
    <dimen name="echo_radius_card">24dp</dimen>
    <dimen name="echo_radius_large">28dp</dimen>
    <dimen name="echo_radius_row">12dp</dimen>
    <dimen name="echo_radius_dialog">30dp</dimen>

    <!-- Artwork radii (Echo: list 6dp, full-player 12dp = 2x, circle avatar). -->
    <dimen name="echo_radius_art_list">6dp</dimen>
    <dimen name="echo_radius_art_player">12dp</dimen>

    <!-- Sheet drag handle (Echo BottomSheetMenu: 40x4dp, 2dp radius). -->
    <dimen name="echo_handle_width">40dp</dimen>
    <dimen name="echo_handle_height">4dp</dimen>

    <!-- Transport buttons (Echo full-player: 68dp circle, 32dp icon;
         play 84dp / 36dp icon — sizes stay as-is, visuals change). -->
    <dimen name="echo_transport_icon">32dp</dimen>

    <!-- Mini-player title scale (Echo: 14sp Medium / 12sp). -->
    <dimen name="echo_mini_title">14sp</dimen>
    <dimen name="echo_mini_artist">12sp</dimen>
</resources>
