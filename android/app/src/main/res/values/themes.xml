<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Both palettes are dark (the app has no light theme); night mode is
         forced in Theme.apply so WebViews and dialogs never flash light. -->
    <style name="Theme.SpotifyDx" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/deep_blue</item>
        <!-- System bars stay out of the theme: a tinted status bar looks
             wrong against the system icon row, so it is always black. -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="colorOnPrimary">@color/deep_text</item>
        <item name="colorSecondary">@color/deep_cyan</item>
        <item name="android:colorBackground">@color/deep_bg</item>
        <item name="colorSurface">@color/deep_surface</item>
        <item name="colorOnSurface">@color/deep_text</item>
        <item name="colorSurfaceVariant">@color/deep_card</item>
        <item name="colorOnSurfaceVariant">@color/deep_muted</item>
        <!-- Echo-port layers (additive only — see values/attrs.xml). -->
        <item name="echoCardShelf">@color/deep_shelf</item>
        <item name="echoSearchField">@color/deep_searchfield</item>
    </style>

    <style name="Theme.SpotifyDx.Onyx" parent="Theme.SpotifyDx">
        <item name="android:colorBackground">@color/onyx_bg</item>
        <item name="colorSurface">@color/onyx_surface</item>
        <item name="colorSurfaceVariant">@color/onyx_card</item>
        <item name="colorOnSurface">@color/onyx_text</item>
        <item name="colorOnSurfaceVariant">@color/onyx_muted</item>
        <item name="echoCardShelf">@color/onyx_shelf</item>
        <item name="echoSearchField">@color/onyx_searchfield</item>
    </style>

    <!-- Pure-black AMOLED overlay: applied ON TOP of either theme when the
         toggle is on. Only background surfaces go true black (window +
         Material surfaces like the nav bar); cards, sheets, dialogs, text
         and accents resolve from the base theme unchanged. -->
    <style name="ThemeOverlay.SpotifyDx.PureBlack" parent="">
        <item name="android:colorBackground">@color/pure_black</item>
        <item name="colorSurface">@color/pure_black</item>
    </style>

</resources>
