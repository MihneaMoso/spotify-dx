<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup keeps working, but secret/bulky payloads stay on-device:
     - spotify-dx/ : core data dir (settings.json can hold provider tokens,
       plus the token-store file fallback)
     - audiocache/ : re-fetchable audio bytes (bulk, no point backing up)
     - updates/    : staged self-update APK (re-downloadable)
     The Room database (queue/history/playback, no tokens) and UI prefs
     (theme/engine, no secrets) keep backing up so restores feel seamless. -->
<full-backup-content>
    <exclude domain="file" path="spotify-dx/" />
    <exclude domain="file" path="audiocache/" />
    <exclude domain="file" path="updates/" />
</full-backup-content>
