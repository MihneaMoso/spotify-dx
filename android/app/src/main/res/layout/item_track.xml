<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/pad_half">

    <TextView
        android:id="@+id/track_index"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        style="@style/EchoBodySubtitle" />

    <ImageView
        android:id="@+id/track_art"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="Artwork" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_half">

        <TextView
            android:id="@+id/track_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/EchoBodyTitle"
            android:maxLines="1" />

        <TextView
            android:id="@+id/track_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/EchoBodySubtitle"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/track_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/EchoBodySubtitle" />

    <ImageView
        android:id="@+id/track_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Drag to reorder"
        android:padding="12dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>
