<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player sheet: Echo Music player-view port (sanctioned
     layout revamp, revised to the Echo reference screenshot). Order mirrors
     Echo: minimize + Playing-From header + song menu (same dots as every
     row), large artwork, synced-lyrics preview window,
     title block, slider + times, bare (circle-free) transport, centered
     codec line, spacer pinning the Queue | Lyrics text row to the bottom,
     and the queue / lyrics sections expanding over everything. No volume
     slider (hardware keys own volume); labels stay ours ("Queue"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sheet_top_rounded"
    android:orientation="vertical"
    android:padding="@dimen/pad">

    <View
        android:layout_width="@dimen/echo_handle_width"
        android:layout_height="@dimen/echo_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/pad_half"
        android:background="@drawable/drag_handle"
        android:contentDescription="Drag handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/sheet_minimize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Minimize player"
            android:src="@android:drawable/arrow_down_float" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Playing From"
                style="@style/EchoCaption" />

            <TextView
                android:id="@+id/sheet_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/EchoTitleMedium" />
        </LinearLayout>

        <!-- Queue size, left of the menu dots — visible only with the
             queue section open (it describes that view). -->
        <TextView
            android:id="@+id/sheet_queue_count_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/pad_half"
            android:visibility="gone"
            style="@style/EchoCaption" />

        <ImageButton
            android:id="@+id/sheet_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheet_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/sheet_art"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp"
            android:contentDescription="Artwork"
            android:scaleType="centerCrop" />

        <!-- Synced-lyrics preview window (Spotify feel): previous two lines,
             current line, next two lines. Context lines dim toward the
             edges; height is a screen fraction (set in code, ~1/5). Lines
             wrap (max 2) instead of truncating. -->
        <LinearLayout
            android:id="@+id/sheet_lyrics_preview"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:layout_marginTop="@dimen/pad_half"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/sheet_lp2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.35"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="20dp"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/sheet_lp1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="20dp"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/sheet_lcur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="26dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/sheet_ln1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="20dp"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/sheet_ln2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.35"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="20dp"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:maxLines="1"
            android:text="Not playing"
            style="@style/EchoTitleLarge" />

        <TextView
            android:id="@+id/sheet_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/EchoTitleMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheet_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                style="@style/EchoCaption" />

            <SeekBar
                android:id="@+id/sheet_scrub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb" />

            <TextView
                android:id="@+id/sheet_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                style="@style/EchoCaption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/sheet_prev"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/sheet_play"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginHorizontal="@dimen/pad"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play or pause"
                android:src="@android:drawable/ic_media_play"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/sheet_next"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:src="@android:drawable/ic_media_next"
                android:tint="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheet_tier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            style="@style/EchoCaption" />
    </LinearLayout>

    <Space
        android:id="@+id/sheet_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/sheet_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sheet_tab_queue"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Queue"
            android:textColor="@color/tab_text" />

        <Button
            android:id="@+id/sheet_tab_lyrics"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lyrics"
            android:textColor="@color/tab_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheet_queue_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- In-queue mini player: same transport as the floating bar
             (art, titles, prev/play/next, scrub, times), borderless —
             the sheet surface already frames it. -->
        <LinearLayout
            android:id="@+id/sheet_mini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/mini_player_plain_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/sheet_mini_art"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Album art" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/pad_half">

                    <TextView
                        android:id="@+id/sheet_mini_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Not playing"
                        style="@style/EchoMiniTitle" />

                    <TextView
                        android:id="@+id/sheet_mini_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        style="@style/EchoMiniArtist" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/sheet_mini_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/sheet_mini_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play or pause"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/sheet_mini_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sheet_mini_scrub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxHeight="12dp"
                android:minHeight="12dp"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheet_mini_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    style="@style/EchoCaption" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/sheet_mini_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    style="@style/EchoCaption" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sheet_queue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sheet_lyrics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sheet_lyrics_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/sheet_lyrics_plain_wrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/sheet_lyrics_plain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/colorOnSurface" />
        </ScrollView>

        <TextView
            android:id="@+id/sheet_lyrics_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
