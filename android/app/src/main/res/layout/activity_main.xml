<?xml version="1.0" encoding="utf-8"?>
<!-- App shell (§10.1): top bar | main content | player bar | bottom nav, with
     a fullscreen login overlay layered above and a floating toast. Narrow
     layout: bottom tabs. See layout-sw600dp for the icon-rail variant. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/topbar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/pad_half"
            android:background="?attr/colorSurface">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back" />

            <SearchView
                android:id="@+id/search_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:queryHint="@string/search_hint"
                android:iconifiedByDefault="false" />

            <ImageButton
                android:id="@+id/btn_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="Profile and settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/player_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/mini_player_bg"
            android:padding="12dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="@android:color/white"
                    android:contentDescription="Previous" />

                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@android:color/white"
                    android:contentDescription="Play or pause" />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@android:color/white"
                    android:contentDescription="Next" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/pad_half">

                    <TextView
                        android:id="@+id/player_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not playing"
                        style="@style/EchoMiniTitle"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/player_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        style="@style/EchoMiniArtist"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <SeekBar
                android:id="@+id/scrub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxHeight="12dp"
                android:minHeight="12dp"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    style="@style/EchoCaption" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    style="@style/EchoCaption" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:menu="@menu/bottom_nav"
            app:itemIconTint="@color/nav_icon_tint"
            app:itemTextColor="@color/nav_text_tint"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <!-- Login page host: fullscreen above the gate, hidden otherwise (§8). -->
    <FrameLayout
        android:id="@+id/login_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Full-screen player sheet (persistent overlay à la Echo Music — NOT
         a DialogFragment: dialog windows brought theme/window-token issues
         and rendered empty. Plain views, slide animation, back-aware). -->
    <FrameLayout
        android:id="@+id/player_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/view_player_sheet" />
    </FrameLayout>

    <!-- Toast floats above the player bar (§10.1). -->
    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="170dp"
        android:background="#CC000000"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <!-- Hidden 1px host for the Phase 5 SDK WebView (never GONE: a detached
         view won't boot audio). -->
    <FrameLayout
        android:id="@+id/sdk_holder"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_gravity="bottom|end" />

</FrameLayout>
